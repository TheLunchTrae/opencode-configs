{
  "$schema": "https://cdn.jsdelivr.net/npm/@lunchbox-labs/opencode-model-profiles@0.2.0/schema.json",
  "defaultProfile": "openai",
  "defaults": {
    "reasoning": { "model": "openai/gpt-6-astra", "variant": "high" },
    "coding": { "model": "openai/gpt-6.1-sol", "variant": "medium" },
    "support": { "model": "openai/gpt-6-luna", "variant": "medium" },
    "system": { "model": "openai/gpt-6.1-terra", "variant": "medium" },
    "title": { "model": "openai/gpt-6-luna", "variant": "low" }
  },
  "profiles": {
    // Uses every ref from defaults.
    "openai": {},
    "openai-menial": {
      "reasoning": { "model": "openai/gpt-5.4-mini", "variant": "none" },
      "coding": { "model": "openai/gpt-5.4-mini", "variant": "none" },
      "support": { "model": "openai/gpt-5.4-mini", "variant": "none" }
    },
    "claude": {
      "reasoning": { "model": "anthropic/claude-opus-5-5", "variant": "high" },
      "coding": { "model": "anthropic/claude-sonnet-5-5", "variant": "medium" },
      "support": { "model": "anthropic/claude-haiku-5-5", "variant": "medium" }
    },
    "claude-menial": {
      "reasoning": { "model": "anthropic/claude-haiku-5-5", "variant": "low" },
      "coding": { "model": "anthropic/claude-haiku-5-5", "variant": "low" },
      "support": { "model": "anthropic/claude-haiku-5-5", "variant": "low" }
    },
    "claude-fable": {
      "reasoning": { "model": "anthropic/claude-fable-5-1", "variant": "high" },
      "coding": { "model": "anthropic/claude-opus-5-5", "variant": "medium" },
      "support": { "model": "anthropic/claude-haiku-5-5", "variant": "medium" }
    },
    "combined-general": {
      "reasoning": { "model": "anthropic/claude-opus-5-5", "variant": "high" },
      "coding": { "model": "openai/gpt-6.1-sol", "variant": "medium" }
    },
    "combined-complex": {
      "reasoning": { "model": "anthropic/claude-fable-5-1", "variant": "high" },
      "coding": { "model": "openai/gpt-6-astra", "variant": "high" },
      "support": { "model": "anthropic/claude-sonnet-5-5", "variant": "medium" }
    }
  },
  "builtins": {
    "general": "coding",
    "explore": "support",
    "summary": "system",
    "compaction": "system",
    "title": "title"
  }
}
