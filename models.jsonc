{
  "$schema": "https://cdn.jsdelivr.net/npm/@lunchbox-labs/opencode-model-profiles@0.1.1/schema.json",
  "defaults": {
    "reasoning": { "model": "openai/gpt-6-astra", "variant": "high" },
    "coding": { "model": "openai/gpt-6.1-sol", "variant": "medium" },
    "support": { "model": "openai/gpt-6.1-terra", "variant": "medium" },
    "system": { "model": "openai/gpt-6.1-terra", "variant": "medium" },
    "title": { "model": "openai/gpt-6-luna", "variant": "low" }
  },
  "profiles": {
    "anthropic": {
      "reasoning": { "model": "anthropic/claude-fable-5-1", "variant": "high" },
      "coding": { "model": "anthropic/claude-sonnet-5-5", "variant": "medium" },
      "support": { "model": "anthropic/claude-haiku-5-5", "variant": "medium" }
    }
  },
  "builtins": {
    "general": "coding",
    "explore": "support",
    "summary": "system",
    "compaction": "system",
    "title": "title"
  }
}
