{
  "name": "opencode-configs",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts && npm --prefix packages test",
    "package:plugins": "npm --prefix packages run package:plugins",
    "test:native": "node tests/run-native.mjs",
    "test:native:minimum": "node tests/run-native.mjs minimum",
    "test:package": "node tests/packaged-consumer.mjs",
    "typecheck": "tsc --project tsconfig.json && tsc --project packages/workflow/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write plugins packages tests package.json tsconfig.json eslint.config.mjs prettier.config.mjs",
    "format:check": "prettier --check plugins packages tests package.json tsconfig.json eslint.config.mjs prettier.config.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "opencode": "1.19.x"
  },
  "dependencies": {
    "@lunchbox-labs/opencode-config-composer": "0.0.7",
    "@lunchbox-labs/opencode-prompt-composer": "0.0.6",
    "@lunchbox-labs/opencode-workflow": "file:extensions/workflow.tgz",
    "@opencode-ai/plugin": "1.19.0",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "10.0.1",
    "@opencode-ai/sdk": "1.19.0",
    "@types/node": "24.10.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-regexp": "3.3.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
