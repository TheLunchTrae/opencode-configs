{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@lunchbox-labs/opencode-config-composer@0.3.0",
    "@lunchbox-labs/opencode-prompt-composer@0.1.1",
    "@slkiser/opencode-quota@4.9.0"
  ],
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "disabled_providers": ["opencode"],
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-5.6-luna",
  "subagent_depth": 2,
  "default_agent": "builder",
  "references": {
    "agent-references": {
      "path": "./references/agent",
      "description": "Conditional coding, testing, verification, delegation, documentation, and task guidance.",
      "hidden": true
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "oauth": false
    }
  },
  "permission": {
    "read": {
      "secrets": "deny",
      "secrets/*": "deny",
      "*/secrets": "deny",
      "*/secrets/*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git *--output*": "ask",
      "git *>*": "ask",
      "git checkout*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "sudo*": "ask",
      "python*": "ask",
      "git branch -D*": "deny",
      "git branch * -D *": "deny",
      "git clean *": "deny",
      "git clean -n*": "ask",
      "git clean --dry-run*": "ask",
      "git clean -dn *": "ask",
      "git clean -fdn *": "ask",
      "git clean -xdn *": "ask",
      "git clean -d -n *": "ask",
      "git clean -d --dry-run *": "ask",
      "git clean *--no-*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f *": "deny",
      "git push * +*": "deny",
      "git push *--mirror*": "deny",
      "git reset --hard*": "deny",
      "git reset * --hard*": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm -Rf*": "deny",
      "rm -fR*": "deny",
      "rm -r -f*": "deny",
      "rm -f -r*": "deny",
      "rm -R -f*": "deny",
      "rm -f -R*": "deny",
      "rm --recursive --force*": "deny",
      "rm --force --recursive*": "deny",
      "rm -r --force*": "deny",
      "rm --force -r*": "deny",
      "rm -R --force*": "deny",
      "rm --force -R*": "deny",
      "rm --recursive -f*": "deny",
      "rm -f --recursive*": "deny",
      "rm * -rf*": "deny",
      "rm * -fr*": "deny",
      "rm * -r -f*": "deny",
      "rm * -f -r*": "deny"
    },
    "edit": {
      "*": "deny"
    },
    "task": {
      "*": "deny"
    },
    "github_*": "ask",
    "playwright_*": "ask",
    "context7_*": "ask"
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "groups": ["coding", "writers"],
      "color": "#8AF793"
    },
    "explore": {
      "groups": ["support"],
      "color": "#8AEEF7"
    },
    "summary": {
      "groups": ["system"]
    },
    "compaction": {
      "groups": ["system"],
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "title": {
      "groups": ["system"],
      "options": {
        "reasoningEffort": "low"
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".idea/**"]
  }
}
