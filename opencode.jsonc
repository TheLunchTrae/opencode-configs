{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@slkiser/opencode-quota@4.9.0"],
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "disabled_providers": ["opencode"],
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-5.6-luna",
  "subagent_depth": 2,
  "default_agent": "lead",
  "references": {
    "asd-ste100": {
      "path": "./references/agent-prompts/asd-ste100.md",
      "description": "Technical documentation authority, preservation rules, and verification limits.",
      "hidden": true
    },
    "global-coding-style": {
      "path": "./references/agent-prompts/global-coding-style.md",
      "description": "Project-aware coding defaults; project and language rules take precedence.",
      "hidden": true
    },
    "reviewer-standards": {
      "path": "./references/agent-prompts/reviewer-standards.md",
      "description": "Shared reviewer conduct and verification rules. Read for each review.",
      "hidden": true
    },
    "review-template": {
      "path": "./references/agent-prompts/review-template.md",
      "description": "Shared format for review findings, evidence, counts, and verdict.",
      "hidden": true
    },
    "review-criteria": {
      "path": "./references/agent-prompts/review-criteria.md",
      "description": "Severity and verdict definitions without reviewer-role instructions.",
      "hidden": true
    },
    "review-target": {
      "path": "./references/agent-prompts/review-target.md",
      "description": "Review scope selection and evidence for branch, staged, local, or file targets.",
      "hidden": true
    },
    "delegation-contract": {
      "path": "./references/agent-prompts/delegation-contract.md",
      "description": "Shared assignment and return fields; grants no delegation authority.",
      "hidden": true
    },
    "implementation-standards": {
      "path": "./references/agent-prompts/implementation-standards.md",
      "description": "Shared implementation checks and evidence for developer agents.",
      "hidden": true
    },
    "typescript-guidance": {
      "path": "./references/agent-prompts/typescript-guidance.md",
      "description": "Shared TypeScript and JavaScript guidance for development and review.",
      "hidden": true
    },
    "go-guidance": {
      "path": "./references/agent-prompts/go-guidance.md",
      "description": "Shared Go guidance for development and review.",
      "hidden": true
    },
    "csharp-guidance": {
      "path": "./references/agent-prompts/csharp-guidance.md",
      "description": "Shared C# and .NET guidance for development and review.",
      "hidden": true
    },
    "php-guidance": {
      "path": "./references/agent-prompts/php-guidance.md",
      "description": "Shared PHP guidance for development and review.",
      "hidden": true
    }
  },
  "mcp": {
    "github": {
      "enabled": false
    },
    "playwright": {
      "enabled": false
    }
  },
  "permission": {
    "read": {
      "~/.config/opencode/secrets": "deny",
      "~/.config/opencode/secrets/**": "deny"
    },
    "bash": {
      "*": "ask",
      "git checkout*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "sudo*": "ask",
      "python*": "ask",
      "git branch -D*": "deny",
      "git clean -f*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    },
    "edit": {
      "*": "ask"
    },
    "external_directory": {
      "*": "ask"
    },
    "task": {
      "*": "deny"
    }
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "edit": "allow"
      }
    },
    "explore": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "summary": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "compaction": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "title": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "options": {
        "reasoningEffort": "low"
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".idea/**"]
  }
}
