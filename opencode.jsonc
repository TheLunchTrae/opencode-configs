{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@lunchbox-labs/opencode-model-profiles@0.2.0", "@lunchbox-labs/opencode-prompt-composer@0.2.4"],
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "disabled_providers": ["opencode"],
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-6-luna",
  "subagent_depth": 2,
  "default_agent": "builder",
  "references": {
    "agent-references": {
      "path": "./references/agent",
      "description": "Conditional coding, testing, verification, delegation, documentation, and task guidance.",
      "hidden": true
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "read": {
      "secrets": "deny",
      "secrets/*": "deny",
      "*/secrets": "deny",
      "*/secrets/*": "deny"
    },
    "bash": {
      "git commit *": "ask",
      "git push*": "ask",
      "git stash *": "ask",
      "git checkout *": "ask",
      "sudo *": "ask",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git filter-branch*": "deny",
      "git filter-repo*": "deny",
      "gh pr merge*": "deny",
      "gh repo delete*": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "npm unpublish*": "deny",
      "kubectl delete*": "deny"
    },
    "edit": {
      "*": "deny"
    },
    "task": {
      "*": "deny"
    },
    "github_*": "ask",
    "playwright_*": "ask"
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "color": "#8AF793",
      "permission": {
        "edit": "allow"
      }
    },
    "explore": {
      "color": "#8AEEF7"
    },
    "summary": {
      "permission": {
        "edit": "ask"
      }
    },
    "compaction": {
      "options": {
        "reasoningEffort": "medium"
      },
      "permission": {
        "edit": "ask"
      }
    },
    "title": {
      "options": {
        "reasoningEffort": "low"
      },
      "permission": {
        "edit": "ask"
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".idea/**"]
  }
}
