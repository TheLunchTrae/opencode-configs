{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@slkiser/opencode-quota@4.9.0"],
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "disabled_providers": ["opencode"],
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-5.6-luna",
  "subagent_depth": 2,
  "default_agent": "lead",
  "references": {
    "asd-ste100": {
      "path": "./references/asd-ste100.md",
      "description": "ASD-STE100 Simplified Technical English rules for technical documentation."
    },
    "global-coding-style": {
      "path": "./references/global-coding-style.md",
      "description": "Generic global coding style defaults. Project- and language-specific conventions override these."
    },
    "reviewer-standards": {
      "path": "./references/reviewer-standards.md",
      "description": "Universal reviewer rules, severity levels, output format, and verdicts. Load by every reviewer agent."
    },
    "review-template": {
      "path": "./references/review-template.md",
      "description": "Read this file to format code review findings."
    }
  },
  "mcp": {
    "github": {
         "type": "remote",
         "url": "https://api.githubcopilot.com/mcp/",
         "enabled": false,
         "oauth": false,
         "headers": {
           "Authorization": "Bearer {file:secrets/github_token}"
         }
       },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest"
        ],
        "enabled": false
      }
    },
  "permission": {
    "read": {
      "~/.config/opencode/secrets": "deny",
      "~/.config/opencode/secrets/**": "deny"
    },
    "bash": {
      "*": "ask",
      "git checkout*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "sudo*": "ask",
      "python*": "ask",
      "git branch -D*": "deny",
      "git clean -f*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    },
    "edit": {
      "*": "ask"
    },
    "external_directory": {
      "*": "ask"
    },
    "task": {
      "*": "deny"
    }
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "edit": "allow"
      }
    },
    "explore": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "summary": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "compaction": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "title": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "options": {
        "reasoningEffort": "low"
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".idea/**"]
  }
}
