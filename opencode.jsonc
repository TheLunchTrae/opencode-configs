{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@slkiser/opencode-quota@4.9.0"],
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "disabled_providers": ["opencode"],
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-5.6-luna",
  "subagent_depth": 2,
  "default_agent": "workflow-lead",
  "references": {
    "agent-prompts": {
      "path": "./references/agent-prompts",
      "description": "Shared coding, review, delegation, language, and documentation guidance for agent prompts.",
      "hidden": true
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "read": {
      "secrets": "deny",
      "secrets/*": "deny",
      "*/secrets": "deny",
      "*/secrets/*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git *--output*": "ask",
      "git *>*": "ask",
      "git checkout*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "sudo*": "ask",
      "python*": "ask",
      "git branch -D*": "deny",
      "git clean -f*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    },
    "edit": {
      "*": "ask"
    },
    "task": {
      "*": "deny"
    },
    "github_*": "ask",
    "playwright_*": "ask"
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "edit": "allow"
      }
    },
    "explore": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "permission": {
        "edit": "deny"
      }
    },
    "summary": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "compaction": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "title": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "options": {
        "reasoningEffort": "low"
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".idea/**"]
  }
}
