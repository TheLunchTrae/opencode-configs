{
  "$schema": "./node_modules/@lunchbox-labs/opencode-config-composer/schema.json",
  "defaultProfile": "primary",
  "groups": {
    "reasoning": {
      "agent": {
        "modelRef": "reasoning"
      }
    },
    "coding": {
      "agent": {
        "modelRef": "coding"
      }
    },
    "writers": {
      "agent": {
        "permission": {
          "edit": "allow"
        }
      }
    },
    "support": {
      "agent": {
        "modelRef": "support"
      }
    },
    "system": {
      "agent": {
        "model": "openai/gpt-5.6-terra",
        "variant": "medium",
        "permission": {
          "edit": "ask"
        }
      }
    },
    "read-only": {
      "agent": {
        "permission": {
          "bash": "deny",
          "edit": "deny",
          "task": "deny",
          "github_*": "deny",
          "playwright_*": "deny"
        }
      }
    }
  },
  "agent": {
    "title": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low"
    }
  },
  "profiles": {
    "primary": {
      "models": {
        "reasoning": {
          "model": "openai/gpt-6-astra",
          "variant": "high"
        },
        "coding": {
          "model": "openai/gpt-5.6-sol",
          "variant": "medium"
        },
        "support": {
          "model": "openai/gpt-5.6-terra",
          "variant": "medium"
        }
      }
    },
    "openai-latest": {
      "models": {
        "reasoning": {
          "model": "openai/gpt-6-astra",
          "variant": "high"
        },
        "coding": {
          "model": "openai/gpt-6.1-sol",
          "variant": "medium"
        },
        "support": {
          "model": "openai/gpt-6-luna",
          "variant": "medium"
        }
      }
    },
    "anthropic-latest": {
      "models": {
        "reasoning": {
          "model": "anthropic/claude-opus-5-5",
          "variant": "high"
        },
        "coding": {
          "model": "anthropic/claude-sonnet-5-5",
          "variant": "medium"
        },
        "support": {
          "model": "anthropic/claude-haiku-5-5",
          "variant": "medium"
        }
      }
    }
  }
}
