{
  "$schema": "./node_modules/@lunchbox-labs/opencode-config-composer/schema.json",
  "defaultProfile": "current",
  "groups": [
    {
      "name": "workflow",
      "members": {
        "agent": [
          "workflow-lead"
        ]
      }
    },
    {
      "name": "planning",
      "members": {
        "agent": [
          "architect",
          "planner",
          "planning-lead"
        ]
      },
      "agent": {
        "permission": {
          "edit": "deny",
          "bash": "deny"
        }
      }
    },
    {
      "name": "developers",
      "members": {
        "agent": [
          "csharp-developer",
          "doctrine-developer",
          "efcore-developer",
          "github-actions-developer",
          "gitlab-ci-developer",
          "go-developer",
          "implementation-lead",
          "laminas-developer",
          "php-developer",
          "react-developer",
          "typescript-developer",
          "general"
        ]
      },
      "agent": {
        "permission": {
          "edit": "allow"
        }
      }
    },
    {
      "name": "reviewers",
      "members": {
        "agent": [
          "architecture-reviewer",
          "code-reviewer",
          "csharp-reviewer",
          "go-reviewer",
          "php-reviewer",
          "review-lead",
          "security-reviewer",
          "typescript-reviewer"
        ]
      },
      "agent": {
        "permission": {
          "edit": "deny",
          "task": "deny"
        }
      }
    },
    {
      "name": "refactoring",
      "members": {
        "agent": [
          "code-simplifier",
          "performance-optimizer",
          "refactor-cleaner"
        ]
      },
      "agent": {
        "permission": {
          "edit": "allow"
        }
      }
    },
    {
      "name": "documentation",
      "members": {
        "agent": [
          "doc-updater"
        ]
      }
    },
    {
      "name": "research",
      "members": {
        "agent": [
          "explore"
        ]
      }
    },
    {
      "name": "system",
      "members": {
        "agent": [
          "summary",
          "compaction",
          "title"
        ]
      },
      "agent": {
        "model": "openai/gpt-5.6-terra",
        "variant": "medium"
      }
    },
    {
      "name": "developer-delegation",
      "members": {
        "agent": [
          "doc-updater",
          "refactor-cleaner"
        ]
      },
      "agent": {
        "permission": {
          "edit": "allow",
          "task": {
            "*": "deny",
            "typescript-developer": "allow",
            "go-developer": "allow",
            "csharp-developer": "allow",
            "php-developer": "allow"
          }
        }
      }
    },
    {
      "name": "delegating-reviewers",
      "members": {
        "agent": [
          "code-reviewer",
          "security-reviewer"
        ]
      },
      "agent": {
        "permission": {
          "edit": "deny",
          "task": {
            "*": "deny",
            "typescript-reviewer": "allow",
            "go-reviewer": "allow",
            "csharp-reviewer": "allow",
            "php-reviewer": "allow"
          }
        }
      }
    }
  ],
