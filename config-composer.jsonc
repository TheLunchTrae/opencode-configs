{
  "$schema": "./node_modules/@lunchbox-labs/opencode-config-composer/schema.json",
  "defaultProfile": "primary",
  "groups": {
    "workflow": {},
    "planning": {},
    "developers": {
      "agent": {
        "permission": {
          "edit": "allow"
        }
      }
    },
    "reviewers": {},
    "refactoring": {
      "agent": {
        "permission": {
          "edit": "allow"
        }
      }
    },
    "documentation": {},
    "research": {
      "agent": {
        "permission": {
          "edit": "deny"
        }
      }
    },
    "system": {
      "agent": {
        "model": "openai/gpt-5.6-terra",
        "variant": "medium"
      }
    },
    "developer-delegation": {
      "agent": {
        "permission": {
          "edit": "allow",
          "task": {
            "*": "deny",
            "typescript-developer": "allow",
            "go-developer": "allow",
            "csharp-developer": "allow",
            "php-developer": "allow"
          }
        }
      }
    },
    "delegating-reviewers": {
      "agent": {
        "permission": {
          "edit": "deny",
          "task": {
            "*": "deny",
            "typescript-reviewer": "allow",
            "go-reviewer": "allow",
            "csharp-reviewer": "allow",
            "php-reviewer": "allow"
          }
        }
      }
    },
    "read-only": {
      "agent": {
        "permission": {
          "edit": "deny",
          "bash": "deny"
        }
      }
    },
    "non-delegating-reviewer": {
      "agent": {
        "permission": {
          "edit": "deny",
          "task": "deny"
        }
      }
    }
  },
  "agent": {
