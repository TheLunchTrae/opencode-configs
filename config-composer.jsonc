{
  "$schema": "./node_modules/@lunchbox-labs/opencode-config-composer/schema.json",
  "defaultProfile": "primary",
  "groups": {
    "workflow": {
      "agent": {
        "modelRef": "reasoning"
      }
    },
    "planning": {
      "agent": {
        "modelRef": "reasoning"
      }
    },
    "developers": {
      "agent": {
        "modelRef": "coding",
        "permission": {
          "edit": "allow"
        }
      }
    },
    "reviewers": {
      "agent": {
        "modelRef": "reasoning"
      }
    },
    "refactoring": {
      "agent": {
        "modelRef": "coding",
        "permission": {
          "edit": "allow"
        }
      }
    },
    "documentation": {
      "agent": {
        "modelRef": "support"
      }
    },
    "research": {
      "agent": {
        "modelRef": "support"
      }
    },
    "system": {
      "agent": {
        "model": "openai/gpt-5.6-terra",
        "variant": "medium",
        "permission": {
          "edit": "ask"
        }
      }
    },
    "developer-delegation": {
      "agent": {
        "permission": {
          "edit": "allow",
          "task": {
            "typescript-developer": "allow",
            "go-developer": "allow",
            "csharp-developer": "allow",
            "php-developer": "allow"
          }
        }
      }
    },
    "delegating-reviewers": {
      "agent": {
        "permission": {
          "task": {
            "typescript-reviewer": "allow",
            "go-reviewer": "allow",
            "csharp-reviewer": "allow",
            "php-reviewer": "allow"
          }
        }
      }
    },
    "read-only": {
      "agent": {
        "permission": {
          "bash": "deny"
        }
      }
    }
  },
  "agent": {
    "title": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low"
    },
    "doctrine-developer": {
      "modelRef": "reasoning"
    },
    "efcore-developer": {
      "modelRef": "reasoning"
    },
    "implementation-lead": {
      "modelRef": "reasoning"
    },
    "performance-optimizer": {
      "modelRef": "reasoning"
    }
  },
  "profiles": {
    "primary": {
      "models": {
        "reasoning": {
          "model": "openai/gpt-6-astra",
          "variant": "high"
        },
        "coding": {
          "model": "openai/gpt-5.6-sol",
          "variant": "medium"
        },
        "support": {
          "model": "openai/gpt-5.6-terra",
          "variant": "medium"
        }
      }
    },
    "openai-latest": {
      "models": {
        "reasoning": {
          "model": "openai/gpt-6-astra",
          "variant": "high"
        },
        "coding": {
          "model": "openai/gpt-6.1-sol",
          "variant": "medium"
        },
        "support": {
          "model": "openai/gpt-6-luna",
          "variant": "medium"
        }
      }
    },
    "anthropic-latest": {
      "models": {
        "reasoning": {
          "model": "anthropic/claude-opus-5-5",
          "variant": "high"
        },
        "coding": {
          "model": "anthropic/claude-sonnet-5-5",
          "variant": "medium"
        },
        "support": {
          "model": "anthropic/claude-haiku-5-5",
          "variant": "medium"
        }
      }
    }
  }
}
