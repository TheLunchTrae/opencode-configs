{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode Config Composer settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "sourceDirectories": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "not": { "pattern": "\\u0000" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/group" }
        },
        "modelPresets": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/preset" }
        },
        "prompts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaults": { "$ref": "#/$defs/prompt" },
            "overrides": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/agentName" },
              "additionalProperties": { "$ref": "#/$defs/agentPrompt" }
            }
          }
        }
      }
    },
    "command": { "type": "object", "maxProperties": 0 },
    "skill": { "type": "object", "maxProperties": 0 }
  },
  "$defs": {
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "not": { "enum": ["constructor", "prototype"] }
    },
    "model": { "type": "string", "pattern": "^[^\\s/]+/\\S+$" },
    "agentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\\\/]+(?:/[^\\s\\\\/]+)*$",
      "not": { "pattern": "(?:^|/)(?:\\.{1,2}|__proto__|constructor|prototype)(?:/|$)" }
    },
    "variant": { "type": "string", "pattern": "^[\\w.-]{1,64}$" },
    "modelRef": {
      "type": "string",
      "anyOf": [
        { "enum": ["opencode:model", "opencode:small_model"] },
        {
          "maxLength": 71,
          "pattern": "^preset:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "not": { "enum": ["preset:constructor", "preset:prototype"] }
        }
      ]
    },
    "promptParts": { "type": "array", "maxItems": 256, "items": { "type": "string" } },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "prepend": { "$ref": "#/$defs/promptParts" }, "append": { "$ref": "#/$defs/promptParts" } }
    },
    "agentPrompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prepend": { "$ref": "#/$defs/promptParts" },
        "append": { "$ref": "#/$defs/promptParts" },
        "inheritDefaults": { "type": "boolean" },
        "inheritGroups": { "type": "boolean" }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": { "model": { "$ref": "#/$defs/model" }, "variant": { "$ref": "#/$defs/variant" } }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/model" },
        "modelRef": { "$ref": "#/$defs/modelRef" },
        "variant": { "$ref": "#/$defs/variant" },
        "prompt": { "$ref": "#/$defs/prompt" }
      },
      "not": { "required": ["model", "modelRef"] },
      "if": { "required": ["variant"] },
      "then": { "anyOf": [{ "required": ["model"] }, { "required": ["modelRef"] }] }
    }
  }
}
